# Terraform working directories
**/.terraform/*

# Terraform state and plans
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Local Terraform variables
*.tfvars
*.auto.tfvars
!*.tfvars.example

# Terraform overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# SSH private/public keys generated for the lab
infrastructure/terraform/aws/.keys/
*.pem
*.key

# OS / editor
.DS_Store
.vscode/settings.json
# Local Python/Ansible environments
.venv/
infrastructure/ansible/.collections/

# Generated OpenStack secrets and rendered runtime files
infrastructure/openstack/kolla/secrets/
clouds.yaml
passwords.yml

# Terraform binary plans without an extension
**/tfplan


local/
# Runtime-only OpenShift installation assets (Ignition, kubeconfig, credentials)
.runtime/
