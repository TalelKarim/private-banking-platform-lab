# OpenShift-capable all-in-one host. The 600 GiB /data volume backs Docker,
# Glance and Nova root disks; Cinder remains on its dedicated 100 GiB EBS.
instance_type      = "r8i.4xlarge"
data_volume_size   = 600
cinder_volume_size = 100

# Stable address baked into the Kolla/OpenStack control-plane configuration.
openstack_host_private_ip = "172.31.31.70"

# Keep null while building the first OpenStack host from Ubuntu.
# After baking, copy the produced AMI ID here in a local *.auto.tfvars file.
# golden_ami_id = "ami-0123456789abcdef0"

# Small, stable administration node. It executes Terraform/Ansible but does not
# host nested workloads itself.
ops_runner_instance_type     = "t3.small"
ops_runner_root_volume_size  = 20

# HCP Terraform Agent. The secret token itself is NOT a Terraform variable.
# Store it once as an SSM Parameter Store SecureString under this path.
tfc_agent_version                  = "1.30.1"
tfc_agent_name                     = "private-banking-ops-runner-01"
tfc_agent_token_ssm_parameter_name = "/private-banking-platform-lab/hcp-terraform/agent-token"

# Routed administration of OpenStack workload floating IPs.
openstack_external_network_cidr = "192.168.250.0/24"

# The matching private key is stored outside Terraform as an SSM SecureString.
workload_ssh_private_key_ssm_parameter_name = "/private-banking-platform-lab/openstack/workload-ssh-private-key"

# PostgreSQL application password path. The value is generated once by Ansible
# on first configuration and stored as a SecureString; Terraform only grants
# the ops-runner least-privilege access to this exact parameter.
postgresql_app_password_ssm_parameter_name = "/private-banking-platform-lab/postgresql/portfolio-app-password"

# Dedicated ingress node. Its stable VPC /32 is trusted by lab-host forwarding
# and OpenStack workload security groups.
edge_gateway_instance_type    = "t3.micro"
edge_gateway_root_volume_size = 12
edge_gateway_private_ip       = "172.31.31.71"
# edge_client_cidr = "82.10.20.30/32"
edge_backend_tcp_ports = [443, 8080]

# Optional cloud-hosted browser for corporate laptops that cannot directly use
# the lab UIs. Enable only while needed; t3.small is deliberately inexpensive.
# The instance gets a fixed EIP and that /32 is automatically allowed on the
# public ALB for Jenkins, Horizon and OpenShift routes.
cloud_browser_enabled          = false
cloud_browser_instance_type    = "t3.small"
cloud_browser_root_volume_size = 30
