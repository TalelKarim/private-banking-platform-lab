# Stable address baked into the Kolla/OpenStack control-plane configuration.
openstack_host_private_ip = "172.31.31.70"

# Keep null while building the first OpenStack host from Ubuntu.
# After baking, copy the produced AMI ID here in a local *.auto.tfvars file.
# golden_ami_id = "ami-0123456789abcdef0"

# Small, stable administration node. It executes Terraform/Ansible but does not
# host nested workloads itself.
ops_runner_instance_type     = "t3.small"
ops_runner_root_volume_size  = 20

# HCP Terraform Agent. The secret token itself is NOT a Terraform variable.
# Store it once as an SSM Parameter Store SecureString under this path.
tfc_agent_version                  = "1.30.1"
tfc_agent_name                     = "private-banking-ops-runner-01"
tfc_agent_token_ssm_parameter_name = "/private-banking-platform-lab/hcp-terraform/agent-token"
