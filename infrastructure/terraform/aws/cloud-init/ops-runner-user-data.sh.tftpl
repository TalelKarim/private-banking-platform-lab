#!/usr/bin/env bash
set -euxo pipefail

exec > >(
  tee -a /var/log/private-banking-lab-ops-runner-bootstrap.log |
  logger -t private-banking-lab-ops-runner -s 2>/dev/console
) 2>&1

export DEBIAN_FRONTEND=noninteractive

# These values are rendered by Terraform templatefile().
TFC_AGENT_VERSION="${tfc_agent_version}"
TFC_AGENT_NAME="${tfc_agent_name}"
TFC_AGENT_TOKEN_PARAMETER="${tfc_agent_token_ssm_parameter_name}"
WORKLOAD_SSH_PRIVATE_KEY_PARAMETER="${workload_ssh_private_key_ssm_parameter_name}"
WORKLOAD_SSH_PRIVATE_KEY_PATH="/home/ubuntu/.ssh/private-banking-openstack-workloads"
AWS_REGION="${aws_region}"

echo "=== Starting private banking lab ops-runner bootstrap ==="
# Give the machine an immediately recognisable operational hostname.
hostnamectl set-hostname ops-runner
if grep -qE '^127\.0\.1\.1[[:space:]]+' /etc/hosts; then
  sed -i -E 's/^127\.0\.1\.1[[:space:]].*/127.0.1.1 ops-runner/' /etc/hosts
else
  printf '127.0.1.1 ops-runner\n' >> /etc/hosts
fi


# ---------------------------------------------------------------------------
# Base packages
# ---------------------------------------------------------------------------

apt-get update

apt-get install -y \
  ca-certificates \
  curl \
  ec2-instance-connect \
  git \
  gnupg \
  jq \
  make \
  openssh-server \
  pipx \
  python3 \
  python3-pip \
  python3-venv \
  unzip

systemctl enable --now ssh

systemctl enable --now \
  snap.amazon-ssm-agent.amazon-ssm-agent.service \
  || systemctl enable --now amazon-ssm-agent \
  || true

# ---------------------------------------------------------------------------
# Terraform CLI
# ---------------------------------------------------------------------------

# Install Terraform from HashiCorp's official APT repository.

install -d -m 0755 /etc/apt/keyrings

curl -fsSL https://apt.releases.hashicorp.com/gpg \
  | gpg --dearmor --yes -o /etc/apt/keyrings/hashicorp.gpg

chmod 0644 /etc/apt/keyrings/hashicorp.gpg

. /etc/os-release

printf \
  'deb [arch=%s signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com %s main\n' \
  "$(dpkg --print-architecture)" \
  "$VERSION_CODENAME" \
  > /etc/apt/sources.list.d/hashicorp.list

apt-get update
apt-get install -y terraform

# ---------------------------------------------------------------------------
# Ansible
# ---------------------------------------------------------------------------

# Keep automation tooling isolated from Ubuntu's system Python.

python3 -m venv /opt/ansible-venv

/opt/ansible-venv/bin/pip install --upgrade pip

/opt/ansible-venv/bin/pip install \
  'ansible-core>=2.19.1,<2.21'

ln -sf /opt/ansible-venv/bin/ansible \
  /usr/local/bin/ansible

ln -sf /opt/ansible-venv/bin/ansible-playbook \
  /usr/local/bin/ansible-playbook

# ---------------------------------------------------------------------------
# OpenStack CLI
# ---------------------------------------------------------------------------

python3 -m venv /opt/openstack-client-venv

/opt/openstack-client-venv/bin/pip install --upgrade pip

/opt/openstack-client-venv/bin/pip install \
  python-openstackclient

ln -sf /opt/openstack-client-venv/bin/openstack \
  /usr/local/bin/openstack

# ---------------------------------------------------------------------------
# AWS CLI v2
# ---------------------------------------------------------------------------

# AWS CLI is used to retrieve the HCP Terraform agent token from
# SSM Parameter Store at boot.
#
# The token itself is never stored in Terraform code or rendered user-data.

rm -rf /tmp/aws /tmp/awscliv2.zip

curl -fsSLo \
  /tmp/awscliv2.zip \
  https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip

unzip -q /tmp/awscliv2.zip -d /tmp

if command -v aws >/dev/null 2>&1; then
  /tmp/aws/install --update
else
  /tmp/aws/install
fi

rm -rf /tmp/aws /tmp/awscliv2.zip

# ---------------------------------------------------------------------------
# OpenStack workload SSH private key
# ---------------------------------------------------------------------------

# The private key is injected once into SSM Parameter Store outside Terraform.
# The runner retrieves it at boot so Ansible can administer every workload VM
# that uses the matching Nova public key. The secret never enters Terraform
# state or rendered user-data.

install -d -m 0700 -o ubuntu -g ubuntu /home/ubuntu/.ssh

set +x

WORKLOAD_SSH_PRIVATE_KEY=""

for attempt in $(seq 1 30); do
  if WORKLOAD_SSH_PRIVATE_KEY=$(aws ssm get-parameter \
    --region "$AWS_REGION" \
    --name "$WORKLOAD_SSH_PRIVATE_KEY_PARAMETER" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text \
    2>/tmp/workload-ssh-key-error.log); then

    if [ -n "$WORKLOAD_SSH_PRIVATE_KEY" ] && [ "$WORKLOAD_SSH_PRIVATE_KEY" != "None" ]; then
      break
    fi
  fi

  sleep 5
done

if [ -z "$WORKLOAD_SSH_PRIVATE_KEY" ] || [ "$WORKLOAD_SSH_PRIVATE_KEY" = "None" ]; then
  echo \
    "ERROR: unable to retrieve OpenStack workload SSH private key from SSM parameter $WORKLOAD_SSH_PRIVATE_KEY_PARAMETER" \
    >&2

  cat /tmp/workload-ssh-key-error.log >&2 || true
  exit 1
fi

printf '%s\n' "$WORKLOAD_SSH_PRIVATE_KEY" > "$WORKLOAD_SSH_PRIVATE_KEY_PATH"
chmod 0600 "$WORKLOAD_SSH_PRIVATE_KEY_PATH"
chown ubuntu:ubuntu "$WORKLOAD_SSH_PRIVATE_KEY_PATH"

unset WORKLOAD_SSH_PRIVATE_KEY
rm -f /tmp/workload-ssh-key-error.log

set -x

# ---------------------------------------------------------------------------
# HCP Terraform Agent
# ---------------------------------------------------------------------------

# Install the pinned HCP Terraform Agent.


install -d \
  -m 0755 \
  -o ubuntu \
  -g ubuntu \
  /opt/tfc-agent

cd /tmp

curl -fsSLO \
  "https://releases.hashicorp.com/tfc-agent/$${TFC_AGENT_VERSION}/tfc-agent_$${TFC_AGENT_VERSION}_linux_amd64.zip"

curl -fsSLO \
  "https://releases.hashicorp.com/tfc-agent/$${TFC_AGENT_VERSION}/tfc-agent_$${TFC_AGENT_VERSION}_SHA256SUMS"

grep \
  "tfc-agent_$${TFC_AGENT_VERSION}_linux_amd64.zip" \
  "tfc-agent_$${TFC_AGENT_VERSION}_SHA256SUMS" \
  | sha256sum -c -

unzip -oq \
  "tfc-agent_$${TFC_AGENT_VERSION}_linux_amd64.zip" \
  -d /opt/tfc-agent

chmod 0755 \
  /opt/tfc-agent/tfc-agent \
  /opt/tfc-agent/tfc-agent-core

chown -R ubuntu:ubuntu /opt/tfc-agent

rm -f \
  "/tmp/tfc-agent_$${TFC_AGENT_VERSION}_linux_amd64.zip" \
  "/tmp/tfc-agent_$${TFC_AGENT_VERSION}_SHA256SUMS"

# ---------------------------------------------------------------------------
# HCP Terraform Agent token
# ---------------------------------------------------------------------------

# Retrieve the agent-pool token at runtime.
#
# Disable shell xtrace before touching the secret so the token can never
# appear in cloud-init logs.

set +x

TFC_AGENT_TOKEN=""

for attempt in $(seq 1 30); do
  if TFC_AGENT_TOKEN=$(aws ssm get-parameter \
    --region "$AWS_REGION" \
    --name "$TFC_AGENT_TOKEN_PARAMETER" \
    --with-decryption \
    --query 'Parameter.Value' \
    --output text \
    2>/tmp/tfc-agent-token-error.log); then

    if [ -n "$TFC_AGENT_TOKEN" ] && [ "$TFC_AGENT_TOKEN" != "None" ]; then
      break
    fi
  fi

  sleep 5
done

if [ -z "$TFC_AGENT_TOKEN" ] || [ "$TFC_AGENT_TOKEN" = "None" ]; then
  echo \
    "ERROR: unable to retrieve HCP Terraform agent token from SSM parameter $TFC_AGENT_TOKEN_PARAMETER" \
    >&2

  cat /tmp/tfc-agent-token-error.log >&2 || true
  exit 1
fi

# ---------------------------------------------------------------------------
# Agent environment
# ---------------------------------------------------------------------------

install \
  -m 0600 \
  -o root \
  -g root \
  /dev/null \
  /etc/tfc-agent.env

{
  printf 'TFC_AGENT_TOKEN=%s\n' "$TFC_AGENT_TOKEN"
  printf 'TFC_AGENT_NAME=%s\n' "$TFC_AGENT_NAME"
  printf 'TFC_AGENT_AUTO_UPDATE=patch\n'
} > /etc/tfc-agent.env

unset TFC_AGENT_TOKEN

rm -f /tmp/tfc-agent-token-error.log

# Secret handling is finished. Re-enable command tracing.
set -x

# ---------------------------------------------------------------------------
# HCP Terraform Agent systemd service
# ---------------------------------------------------------------------------

cat > /etc/systemd/system/tfc-agent.service <<'EOF_TFC_AGENT_SERVICE'
[Unit]
Description=HCP Terraform Agent
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/tfc-agent
Environment=HOME=/home/ubuntu
EnvironmentFile=/etc/tfc-agent.env
ExecStart=/opt/tfc-agent/tfc-agent
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=900

[Install]
WantedBy=multi-user.target
EOF_TFC_AGENT_SERVICE

systemctl daemon-reload
systemctl enable --now tfc-agent.service

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------

install -d \
  -m 0755 \
  -o ubuntu \
  -g ubuntu \
  /home/ubuntu/workspace

# Keep the stateless runner immediately usable after every rebuild by cloning
# the lab repository that contains the Makefile, Ansible and helper scripts.
LAB_REPOSITORY_URL="https://github.com/TalelKarim/private-banking-platform-lab.git"
LAB_REPOSITORY_DIR="/home/ubuntu/workspace/private-banking-platform-lab"

if [ -d "$LAB_REPOSITORY_DIR/.git" ]; then
  sudo -u ubuntu -H git -C "$LAB_REPOSITORY_DIR" pull --ff-only
elif [ -e "$LAB_REPOSITORY_DIR" ]; then
  echo "ERROR: $LAB_REPOSITORY_DIR exists but is not a Git repository" >&2
  exit 1
else
  sudo -u ubuntu -H git clone \
    --branch main \
    --single-branch \
    "$LAB_REPOSITORY_URL" \
    "$LAB_REPOSITORY_DIR"
fi

# ---------------------------------------------------------------------------
# MOTD
# ---------------------------------------------------------------------------

cat > /etc/motd <<'EOF_MOTD'
============================================================
 Private Banking Platform Lab - Ops Runner
============================================================
 Role        : Terraform / Ansible administration runner
 Terraform   : installed
 Ansible     : /opt/ansible-venv
 OpenStack   : /opt/openstack-client-venv
 HCP Agent   : tfc-agent.service
 Workload SSH: /home/ubuntu/.ssh/private-banking-openstack-workloads
 Bootstrap   : /var/log/private-banking-lab-ops-runner-bootstrap.log
============================================================
EOF_MOTD

# ---------------------------------------------------------------------------
# Final validation
# ---------------------------------------------------------------------------

terraform version
ansible --version
openstack --version
aws --version
sudo -u ubuntu test -r "$WORKLOAD_SSH_PRIVATE_KEY_PATH"
sudo -u ubuntu test -d /home/ubuntu/workspace/private-banking-platform-lab/.git

systemctl --no-pager --full status tfc-agent.service

echo "=== Private banking lab ops-runner bootstrap completed ==="