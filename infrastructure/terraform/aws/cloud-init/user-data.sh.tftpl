#!/usr/bin/env bash

set -euxo pipefail

exec > >(
  tee -a /var/log/private-banking-lab-bootstrap.log |
  logger -t private-banking-lab-user-data -s 2>/dev/console
) 2>&1

export DEBIAN_FRONTEND=noninteractive

echo "=== Starting minimal private banking lab bootstrap ==="
# Give the machine an immediately recognisable operational hostname.
hostnamectl set-hostname lab-host
if grep -qE '^127\.0\.1\.1[[:space:]]+' /etc/hosts; then
  sed -i -E 's/^127\.0\.1\.1[[:space:]].*/127.0.1.1 lab-host/' /etc/hosts
else
  printf '127.0.1.1 lab-host\n' >> /etc/hosts
fi


apt-get update
apt-get install -y \
  ca-certificates \
  chrony \
  curl \
  ec2-instance-connect \
  e2fsprogs \
  git \
  jq \
  make \
  nvme-cli \
  openssh-server \
  python3 \
  python3-pip \
  python3-venv \
  rsync \
  unzip

systemctl enable --now ssh
systemctl enable --now chrony
systemctl enable --now \
  snap.amazon-ssm-agent.amazon-ssm-agent.service \
  || systemctl enable --now amazon-ssm-agent \
  || true

install -d -m 0755 /etc/private-banking-lab
cat > /etc/private-banking-lab/volumes.env <<EOF_VOLUMES
DATA_VOLUME_SERIAL=${data_volume_serial}
CINDER_VOLUME_SERIAL=${cinder_volume_serial}
EOF_VOLUMES
chmod 0644 /etc/private-banking-lab/volumes.env

EXPECTED_SERIAL="${data_volume_serial}"
DATA_DEVICE=""

echo "Waiting for persistent data EBS volume: $EXPECTED_SERIAL"

for attempt in $(seq 1 120); do
  DATA_DEVICE=$(
    lsblk -dn -o NAME,SERIAL |
      awk -v expected="$EXPECTED_SERIAL" '$2 == expected { print "/dev/" $1; exit }'
  )

  if [ -n "$DATA_DEVICE" ]; then
    echo "Found persistent data volume at $DATA_DEVICE"
    break
  fi

  sleep 5
done

if [ -z "$DATA_DEVICE" ]; then
  echo "ERROR: persistent data EBS volume was not detected."
  exit 1
fi

if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -F -L lab-data "$DATA_DEVICE"
fi

mkdir -p /data
DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")

if ! grep -q "UUID=$DATA_UUID " /etc/fstab; then
  echo "UUID=$DATA_UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
fi

mount -a
mountpoint -q /data

# Terraform may enlarge the gp3 data volume without recreating its existing
# ext4 filesystem. Grow the filesystem online to consume the new EBS capacity.
if [ "$(findmnt -n -o FSTYPE /data)" = "ext4" ]; then
  resize2fs "$DATA_DEVICE"
fi

# Never recursively chown /data: it can contain persistent Docker/OpenStack
# files with service-specific ownership from a previous host lifecycle.
chown ubuntu:ubuntu /data
install -d -m 0755 -o ubuntu -g ubuntu \
  /data/repos \
  /data/openstack \
  /data/openstack/kolla \
  /data/terraform
install -d -m 0700 -o ubuntu -g ubuntu /data/openstack/secrets

cat > /etc/motd <<'EOF_MOTD'
============================================================
 Private Banking Platform Lab
============================================================
 OS          : Ubuntu 24.04 LTS
 Role        : OpenStack all-in-one host
 Data        : /data
 Next step   : clone repo, then make openstack-up
 Bootstrap   : /var/log/private-banking-lab-bootstrap.log
============================================================
EOF_MOTD

echo "=== Minimal private banking lab bootstrap completed ==="
