#!/usr/bin/env bash

set -euxo pipefail

exec > >(
  tee -a /var/log/private-banking-lab-bootstrap.log |
  logger -t private-banking-lab-user-data -s 2>/dev/console
) 2>&1

export DEBIAN_FRONTEND=noninteractive

echo "=== Starting private banking platform lab bootstrap ==="

apt-get update

apt-get install -y \
  apt-transport-https \
  bash-completion \
  bridge-utils \
  build-essential \
  ca-certificates \
  chrony \
  conntrack \
  cpu-checker \
  curl \
  ec2-instance-connect \
  gcc \
  git \
  gnupg \
  htop \
  iproute2 \
  iptables \
  jq \
  libdbus-glib-1-dev \
  libffi-dev \
  libssl-dev \
  libvirt-clients \
  libvirt-daemon-system \
  lsb-release \
  make \
  net-tools \
  nvme-cli \
  openssl \
  pipx \
  python3 \
  python3-dev \
  python3-pip \
  python3-venv \
  qemu-kvm \
  rsync \
  socat \
  software-properties-common \
  tmux \
  tree \
  unzip \
  vim \
  wget \
  zip

# -------------------------------------------------------------------
# Docker repository and packages
# -------------------------------------------------------------------

install -m 0755 -d /etc/apt/keyrings

curl -fsSL https://download.docker.com/linux/ubuntu/gpg |
  gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg

chmod a+r /etc/apt/keyrings/docker.gpg

. /etc/os-release

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $VERSION_CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

# -------------------------------------------------------------------
# HashiCorp repository and Terraform CLI
# -------------------------------------------------------------------

wget -qO- https://apt.releases.hashicorp.com/gpg |
  gpg --dearmor --yes -o /etc/apt/keyrings/hashicorp.gpg

echo \
  "deb [signed-by=/etc/apt/keyrings/hashicorp.gpg] https://apt.releases.hashicorp.com $VERSION_CODENAME main" \
  > /etc/apt/sources.list.d/hashicorp.list

apt-get update

apt-get install -y \
  containerd.io \
  docker-buildx-plugin \
  docker-ce \
  docker-ce-cli \
  docker-compose-plugin \
  terraform

# -------------------------------------------------------------------
# Kernel modules needed by KVM, containers and OpenStack networking
# -------------------------------------------------------------------

cat > /etc/modules-load.d/private-banking-lab.conf <<'EOF'
kvm
kvm_intel
br_netfilter
overlay
EOF

modprobe kvm || true
modprobe kvm_intel || true
modprobe br_netfilter || true
modprobe overlay || true

cat > /etc/modprobe.d/kvm-intel.conf <<'EOF'
options kvm_intel nested=1
EOF

# -------------------------------------------------------------------
# Network and kernel settings
# -------------------------------------------------------------------

cat > /etc/sysctl.d/99-private-banking-lab.conf <<'EOF'
net.ipv4.ip_forward = 1
net.bridge.bridge-nf-call-iptables = 1
net.bridge.bridge-nf-call-ip6tables = 1
vm.max_map_count = 262144
fs.inotify.max_user_instances = 8192
fs.inotify.max_user_watches = 524288
EOF

sysctl --system

# -------------------------------------------------------------------
# Create a second logical interface for Neutron/Kolla
# -------------------------------------------------------------------

cat > /etc/systemd/system/private-banking-dummy-interface.service <<'EOF'
[Unit]
Description=Create dummy0 interface for OpenStack Neutron
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '/usr/sbin/ip link show dummy0 >/dev/null 2>&1 || /usr/sbin/ip link add dummy0 type dummy'
ExecStart=/usr/sbin/ip link set dummy0 up
ExecStop=/usr/sbin/ip link delete dummy0

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now private-banking-dummy-interface.service

# -------------------------------------------------------------------
# Wait for and mount the persistent EBS data volume
# -------------------------------------------------------------------

EXPECTED_SERIAL="${data_volume_serial}"
DATA_DEVICE=""

echo "Waiting for EBS volume with serial: $EXPECTED_SERIAL"

for attempt in $(seq 1 120); do
  DATA_DEVICE=$(
    lsblk -dn -o NAME,SERIAL |
      awk -v expected="$EXPECTED_SERIAL" '$2 == expected { print "/dev/" $1; exit }'
  )

  if [ -n "$DATA_DEVICE" ]; then
    echo "Found data volume at $DATA_DEVICE"
    break
  fi

  sleep 5
done

if [ -n "$DATA_DEVICE" ]; then
  if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
    mkfs.ext4 -F -L lab-data "$DATA_DEVICE"
  fi

  mkdir -p /data

  DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")

  if ! grep -q "UUID=$DATA_UUID " /etc/fstab; then
    echo "UUID=$DATA_UUID /data ext4 defaults,nofail 0 2" >> /etc/fstab
  fi

  mount -a
  chown ubuntu:ubuntu /data
else
  echo "WARNING: persistent data EBS volume was not detected."
fi

# AWS exposes EBS volumes as NVMe devices on Nitro instances.
# We identify the volume by its stable EBS serial instead of nvme1n1,
# because the NVMe device name can change between boots.

# -------------------------------------------------------------------
# Persistent working directories
# -------------------------------------------------------------------

if mountpoint -q /data; then
  mkdir -p \
    /data/docker \
    /data/openstack \
    /data/cinder \
    /data/nova \
    /data/images \
    /data/repos \
    /data/terraform

  chown -R ubuntu:ubuntu /data
  DOCKER_DATA_ROOT="/data/docker"
else
  DOCKER_DATA_ROOT="/var/lib/docker"
fi

# -------------------------------------------------------------------
# Docker configuration
# -------------------------------------------------------------------

systemctl stop docker || true

cat > /etc/docker/daemon.json <<EOF
{
  "data-root": "$DOCKER_DATA_ROOT",
  "storage-driver": "overlay2",
  "log-driver": "json-file",
  "log-opts": {
    "max-size": "50m",
    "max-file": "3"
  }
}
EOF

systemctl enable --now containerd
systemctl enable --now docker

# -------------------------------------------------------------------
# Users and permissions
# -------------------------------------------------------------------

usermod -aG docker ubuntu
usermod -aG libvirt ubuntu
usermod -aG kvm ubuntu

mkdir -p /etc/kolla
chown ubuntu:ubuntu /etc/kolla

python3 -m venv /opt/kolla-venv
chown -R ubuntu:ubuntu /opt/kolla-venv

# -------------------------------------------------------------------
# SSH, SSM and base services
# -------------------------------------------------------------------

systemctl enable --now ssh
systemctl enable --now chrony
systemctl enable --now libvirtd

systemctl enable --now \
  snap.amazon-ssm-agent.amazon-ssm-agent.service \
  || systemctl enable --now amazon-ssm-agent \
  || true

# -------------------------------------------------------------------
# KVM validation
# -------------------------------------------------------------------

if [ -c /dev/kvm ]; then
  echo "SUCCESS: /dev/kvm is available."
  ls -l /dev/kvm
  kvm-ok || true
else
  echo "ERROR: /dev/kvm is not available."
  echo "Check the EC2 nested virtualization CPU option."
fi

lscpu || true

# -------------------------------------------------------------------
# Helpful MOTD
# -------------------------------------------------------------------

cat > /etc/motd <<'EOF'
============================================================
 Private Banking Platform Lab
============================================================
 OS          : Ubuntu 24.04 LTS
 Role        : OpenStack all-in-one host
 Data        : /data
 Kolla venv  : /opt/kolla-venv
 Kolla config: /etc/kolla
 Bootstrap   : /var/log/private-banking-lab-bootstrap.log
============================================================
EOF

terraform version || true
docker version || true
virsh version || true

echo "=== Private banking platform lab bootstrap completed ==="