# Runtime-only delivery point for installer-generated Ignition artifacts.
server {
    listen {{ okd_lb_ip }}:{{ okd_ignition_http_port }};
    server_name _;

    access_log /var/log/nginx/okd-ignition-access.log;
    error_log  /var/log/nginx/okd-ignition-error.log;

    root {{ okd_lb_ignition_root }};
    autoindex off;
    server_tokens off;

    location = /healthz {
        default_type text/plain;
        return 200 'ok\n';
    }

    location / {
        default_type application/json;
        try_files $uri =404;
    }
}
