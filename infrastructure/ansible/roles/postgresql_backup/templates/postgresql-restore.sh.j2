#!/usr/bin/env bash
set -euo pipefail

# Do not inherit an inaccessible caller working directory (for example
# /home/ubuntu when invoked through sudo -u postgres over SSH).
cd /

DATABASE={{ postgresql_database_name | quote }}
OWNER_ROLE={{ postgresql_owner_role | quote }}
BACKUP_DIR={{ postgresql_backup_directory | quote }}
PG_RESTORE=/usr/lib/postgresql/{{ postgresql_major_version }}/bin/pg_restore
PSQL=/usr/bin/psql
CREATEDB=/usr/bin/createdb
DROPDB=/usr/bin/dropdb

usage() {
  cat >&2 <<USAGE
Usage: $0 <backup-file|latest> <target-database> [confirmation]

Safe example:
  $0 latest ${DATABASE}_restore_manual

Replacing the live ${DATABASE} database is deliberately blocked unless the
third argument is exactly RESTORE_${DATABASE}.
USAGE
  exit 2
}

if [[ "$(id -un)" != "postgres" ]]; then
  echo "Run this command as the Linux postgres user (for example: sudo -u postgres $0 ...)." >&2
  exit 1
fi

backup_name=${1:-}
target_database=${2:-}
confirmation=${3:-}

[[ -n "$backup_name" && -n "$target_database" ]] || usage
[[ "$target_database" =~ ^[a-z][a-z0-9_]*$ ]] || {
  echo "Invalid target database name: $target_database" >&2
  exit 2
}

if [[ "$backup_name" == "latest" ]]; then
  backup_name=$(find "$BACKUP_DIR" -maxdepth 1 -type f \
    -name "${DATABASE}_*.dump" -printf '%f\n' | sort | tail -n1)
fi

[[ "$backup_name" =~ ^${DATABASE}_[0-9]{8}T[0-9]{6}Z\.dump$ ]] || {
  echo "Invalid backup file name: $backup_name" >&2
  exit 2
}

backup_path="$BACKUP_DIR/$backup_name"
checksum_path="${backup_path}.sha256"
[[ -f "$backup_path" ]] || {
  echo "Backup does not exist: $backup_path" >&2
  exit 1
}

if [[ -f "$checksum_path" ]]; then
  (cd "$BACKUP_DIR" && sha256sum --check "$(basename "$checksum_path")")
else
  echo "Backup checksum is missing: $checksum_path" >&2
  exit 1
fi

"$PG_RESTORE" --list "$backup_path" >/dev/null

if [[ "$target_database" == "$DATABASE" && "$confirmation" != "RESTORE_${DATABASE}" ]]; then
  echo "Refusing to replace live database '$DATABASE' without confirmation RESTORE_${DATABASE}." >&2
  exit 2
fi

# Disconnect sessions before replacing a database. The target name is restricted
# to [a-z0-9_], so it is safe to embed in this administrative SQL statement.
"$PSQL" --dbname=postgres --set=ON_ERROR_STOP=1 --quiet --tuples-only --command \
  "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${target_database}' AND pid <> pg_backend_pid();" >/dev/null

"$DROPDB" --if-exists --force "$target_database"
"$CREATEDB" --owner="$OWNER_ROLE" "$target_database"

if ! "$PG_RESTORE" --exit-on-error --dbname="$target_database" "$backup_path"; then
  echo "Restore failed. Target database '$target_database' is left in place for inspection." >&2
  exit 1
fi

printf 'Restored %s into database %s\n' "$backup_name" "$target_database"
