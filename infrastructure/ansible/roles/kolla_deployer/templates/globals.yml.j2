---
# Generated by infrastructure/ansible/roles/kolla_deployer.
kolla_base_distro: "ubuntu"
kolla_container_engine: "docker"

# Kolla bootstraps host-side Python dependencies (including the Docker SDK)
# into a dedicated target virtualenv. The bootstrap phase itself uses system Python.
virtualenv: "{{ kolla_target_venv }}"
virtualenv_site_packages: true

network_interface: "{{ ansible_default_ipv4.interface }}"
api_interface: "{{ ansible_default_ipv4.interface }}"
tunnel_interface: "{{ ansible_default_ipv4.interface }}"
neutron_external_interface: "{{ openstack_external_neutron_interface }}"
neutron_plugin_agent: "openvswitch"

# A single-node lab does not need a floating control-plane VIP.
kolla_internal_vip_address: "{{ ansible_default_ipv4.address }}"
enable_haproxy: false
enable_keepalived: false

nova_compute_virt_type: "kvm"

docker_runtime_directory: "/data/docker"
docker_storage_driver: "overlay2"
docker_log_max_size: "50m"
docker_log_max_file: "3"
